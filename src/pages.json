				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/public/errorPage",
			"style": {
				"navigationBarTitleText": "服务异常",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/public/agreePage",
			"style": {
				"navigationBarTitleText": "用户协议",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/user/login",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/me/index",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/cashier/index",
			"style": {
				"navigationBarTitleText": "收银台",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/order/index",
			"style": {
				"navigationBarTitleText": "兑换订单",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom"
			}
		}
	],
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#9aa0ab",
		"selectedColor": "#ff6a3d",
		"borderStyle": "white",
		"backgroundColor": "#ffffff",
		"list": [
			{
				"pagePath": "pages/index/index",
				"iconPath": "static/tab-home.png",
				"selectedIconPath": "static/tab-home-active.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/me/index",
				"iconPath": "static/tab-me.png",
				"selectedIconPath": "static/tab-me-active.png",
				"text": "我的"
			}
		]
	}
}